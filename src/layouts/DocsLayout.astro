---
import BaseLayout from "./BaseLayout.astro";
import { components } from "../components/componentMap";
import DesignSystemExplorer from "../components/Docs/DesignSystemExplorer.astro";

interface Props {
  title: string;
  description: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  entry: any;
}

const { title, description, entry } = Astro.props;
const { data: pageData } = entry;
const { content } = pageData;

const isDesignSystemPage =
  typeof entry?.slug === "string" && entry.slug.endsWith("/design-system");

// List of all available components for the sidebar
const componentsList = [
  { name: "Hero", slug: "heroes" },
  { name: "Split Content", slug: "split-content" },
  { name: "Feature Card", slug: "feature-card" },
  { name: "Gift Card", slug: "gift-card" },
  { name: "Quote", slug: "quote" },
  { name: "CTA", slug: "cta" },
];

// Get current page from URL
const currentPath = Astro.url.pathname;
const isOverview =
  currentPath === "/docs" ||
  currentPath === "/docs/" ||
  currentPath === "/en/docs" ||
  currentPath === "/en/docs/";
---

<BaseLayout
  title={title}
  description={description}
  image={pageData?.meta?.image}
>
  <div class="docs-container min-h-screen bg-canvas">
    <div class="flex">
      <!-- Sidebar Navigation -->
      <aside
        class="docs-sidebar w-64 bg-surface border-r border-border-subtle min-h-screen sticky top-0 overflow-y-auto"
      >
        <div class="p-6">
          <h2 class="text-xl font-bold text-primary-900 mb-2">Component Docs</h2>
          <p class="text-sm text-ink-muted mb-6">Browse available components</p>

          <nav>
            <ul class="space-y-1">
              <li>
                <a
                  href="/docs"
                  class={`block px-4 py-2 rounded-lg text-sm transition-colors ${
                    isOverview
                      ? "bg-primary-100 text-primary-900 font-semibold"
                      : "text-ink-muted hover:bg-surface-alt hover:text-primary-900"
                  }`}
                >
                  Overview
                </a>
              </li>

              <li class="pt-4">
                <p
                  class="px-4 text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2"
                >
                  Foundations
                </p>
                <ul class="space-y-1">
                  <li>
                    <a
                      href="/docs/design-system"
                      class={`block px-4 py-2 rounded-lg text-sm transition-colors ${
                        currentPath.includes("/docs/design-system")
                          ? "bg-primary-100 text-primary-900 font-semibold"
                          : "text-ink-muted hover:bg-surface-alt hover:text-primary-900"
                      }`}
                    >
                      Design System
                    </a>
                  </li>
                </ul>
              </li>

              <li class="pt-4">
                <p
                  class="px-4 text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2"
                >
                  Components
                </p>
                <ul class="space-y-1">
                  {
                    componentsList.map((component) => (
                      <li>
                        <a
                          href={`/docs/${component.slug}`}
                          class={`block px-4 py-2 rounded-lg text-sm transition-colors ${
                            currentPath.includes(`/docs/${component.slug}`)
                              ? "bg-primary-100 text-primary-900 font-semibold"
                              : "text-ink-muted hover:bg-surface-alt hover:text-primary-900"
                          }`}
                        >
                          {component.name}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </li>
            </ul>
          </nav>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="docs-main flex-1 p-6 md:p-10">
        <div class:list={["mx-auto", isDesignSystemPage ? "max-w-6xl" : "max-w-5xl"]}>
          <!-- Page Header -->
          <div class="mb-8">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
              {title}
            </h1>
            {description && <p class="text-xl text-gray-600">{description}</p>}
          </div>

          {isDesignSystemPage && <DesignSystemExplorer />}

          <!-- Component Preview Section -->
          {
            content && content.length > 0 && (
              <div class="component-preview-section mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">
                  Live Preview
                </h2>
                <div class="border-2 border-gray-300 rounded-lg overflow-hidden bg-white shadow-sm">
                  {content.map((block) => {
                    const Component =
                      components[block.component] ?? components.fallback;
                    return <Component {...block} />;
                  })}
                </div>
              </div>
            )
          }

          <!-- Slot for additional documentation content -->
          <div class="documentation-content prose prose-lg max-w-none">
            <slot />
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-sidebar {
    height: 100vh;
  }

  @media (max-width: 768px) {
    .docs-sidebar {
      display: none;
    }
  }

  .prose {
    color: #374151;
  }

  .prose h2 {
    color: #1f2937;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: #374151;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
</style>
