---
// Supports weights 300-700 (Cormorant Garamond) & 200-800 (Plus Jakarta Sans)
import "@fontsource-variable/cormorant-garamond";
import "@fontsource-variable/plus-jakarta-sans";
import cormorantLatinUrl from "@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url";
import jakartaLatinUrl from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";

import Header from "../components/Global/Header.astro";
import Footer from "../components/Global/Footer.astro";
import WhatsAppButton from "../components/UI/WhatsAppButton.astro";
import Meta from "../components/Global/Meta.astro";
import { t, getCurrentLocaleFromAstro } from "../i18n";

import favicon16 from "../assets/favicon-16x16.png";
import favicon32 from "../assets/favicon-32x32.png";
import appleTouchIcon from "../assets/apple-touch-icon.png";
import faviconIco from "../assets/favicon.ico";
import android192 from "../assets/android-chrome-192x192.png";
import android512 from "../assets/android-chrome-512x512.png";

import GoogleTagManager from "../components/Analytics/GoogleTagManager.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  videoId?: string;
  uploadDate?: string;
  enUrl?: string;
  esUrl?: string;
}

const { title, description, image, videoId, uploadDate, enUrl, esUrl } = Astro.props as Props;
const currentLocale = getCurrentLocaleFromAstro(Astro);
const isRoot = Astro.url.pathname === "/";
const enWhatsappMessage = await t("whatsapp.message", "en");
const esWhatsappMessage = await t("whatsapp.message", "es");
const whatsappMessage = await t("whatsapp.message", currentLocale);
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={cormorantLatinUrl}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={jakartaLatinUrl}
      crossorigin="anonymous"
    />
    <meta name="theme-color" content="#0B1120" />
    <link rel="shortcut icon" href={faviconIco.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="icon" type="image/png" sizes="192x192" href={android192.src} />
    <link rel="icon" type="image/png" sizes="512x512" href={android512.src} />
    <meta name="generator" content={Astro.generator} />
    <Meta
      title={title}
      description={description}
      image={image}
      videoId={videoId}
      uploadDate={uploadDate}
      enUrl={enUrl}
      esUrl={esUrl}
    />
    <title>{title}</title>
    <slot name="head" />
    <GoogleTagManager />
  </head>
  <body class="font-sans">
    <div class="flex flex-col min-h-screen">
      <Header enUrl={enUrl} esUrl={esUrl} />

      <main class="flex-grow">
        <slot />
      </main>

      <Footer enUrl={enUrl} esUrl={esUrl} />
    </div>

    <!-- WhatsApp Floating Button -->
    {
      isRoot ? (
        <>
          <WhatsAppButton class="lang-en" message={enWhatsappMessage} />
          <WhatsAppButton class="lang-es" message={esWhatsappMessage} />
        </>
      ) : (
        <WhatsAppButton message={whatsappMessage} />
      )
    }
    <!-- Site-wide is-loaded readiness event (LCP-safe: coordinates fonts + first Hero canvas frame) -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (root.classList.contains("is-loaded")) return;

        let fired = false;
        let fontsLoaded = false;
        const heroes = Array.from(
          document.querySelectorAll("celestial-hero-canvas")
        );
        const heroEl =
          heroes.find((el) => el.offsetParent !== null) || heroes[0];
        const hasHero = Boolean(heroEl);

        const finish = () => {
          if (fired) return;
          fired = true;
          root.classList.add("is-loaded");
          root.dataset.siteLoaded = "true";
          window.dispatchEvent(
            new CustomEvent("is-loaded", {
              detail: { hasHero, fontsLoaded },
            })
          );
        };

        const fontsReady =
          document.fonts && document.fonts.ready
            ? document.fonts.ready.then(() => {
                fontsLoaded = true;
              })
            : Promise.resolve();

        const heroReady =
          !heroEl || heroEl.dataset.canvasReady === "true"
            ? Promise.resolve()
            : new Promise((resolve) => {
                heroEl.addEventListener("hero:ready", resolve, { once: true });
              });

        const safetyTimer = setTimeout(finish, 900);
        Promise.all([fontsReady, heroReady]).then(() => {
          clearTimeout(safetyTimer);
          requestAnimationFrame(finish);
        });
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
