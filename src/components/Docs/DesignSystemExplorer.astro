---
interface ThemeDef {
  id: string;
  name: string;
  subtitle: string;
  vibe: string;
  recommended?: boolean;
  rationale: string;
  tokens: {
    canvas: string;
    surface: string;
    surfaceAlt: string;
    darkStart: string;
    darkEnd: string;
    footerBg: string;
    primary: string;
    primaryHover: string;
    primaryInk: string;
    accent: string;
    accentHover: string;
    accentInk: string;
    accentSoft: string;
    ink: string;
    inkMuted: string;
    darkInk: string;
    darkInkMuted: string;
    border: string;
    darkBorder: string;
    glowA: string;
    glowB: string;
  };
  swatches: { label: string; role: string; hex: string }[];
}

const themes: ThemeDef[] = [
  {
    id: "astrolabio",
    name: "Astrolabio Nocturno",
    subtitle: "Celestial Navy & Antique Gold",
    vibe: "Astronomía clásica · Calma médica · Alta confianza",
    recommended: true,
    rationale:
      "Conecta directamente con las fotos de cielo nocturno, el footer oscuro y la tarjeta regalo azul con dorado de Glenda. Elimina el choque morado/naranja.",
    tokens: {
      canvas: "#F7F5F0",
      surface: "#FFFFFF",
      surfaceAlt: "#EFECE4",
      darkStart: "#0F172A",
      darkEnd: "#1E2D4F",
      footerBg: "#0B1120",
      primary: "#1E2D4F",
      primaryHover: "#15213B",
      primaryInk: "#FFFFFF",
      accent: "#B88A44",
      accentHover: "#9F7434",
      accentInk: "#FFFFFF",
      accentSoft: "rgba(184, 138, 68, 0.16)",
      ink: "#141D30",
      inkMuted: "#4B5568",
      darkInk: "#F8FAFC",
      darkInkMuted: "#CBD5E1",
      border: "#E2DDD2",
      darkBorder: "rgba(212, 180, 117, 0.25)",
      glowA: "rgba(96, 132, 214, 0.20)",
      glowB: "rgba(184, 138, 68, 0.18)",
    },
    swatches: [
      { label: "Alabaster", role: "Canvas", hex: "#F7F5F0" },
      { label: "Ivory", role: "Surface", hex: "#FFFFFF" },
      { label: "Midnight", role: "Dark Band", hex: "#0F172A" },
      { label: "Indigo", role: "Primary", hex: "#1E2D4F" },
      { label: "Antique Gold", role: "Accent", hex: "#B88A44" },
      { label: "Deep Ink", role: "Text", hex: "#141D30" },
    ],
  },
  {
    id: "manuscrito",
    name: "Manuscrito Médico",
    subtitle: "Warm Parchment, Botanical Sage & Ochre",
    vibe: "Astrología médica tradicional · Ciencia & sabiduría antigua",
    rationale:
      "Diferencia a Glenda de cualquier sitio genérico de horóscopos morados. Evoca medicina hipocrática, botánica tradicional y rigor editorial cálido.",
    tokens: {
      canvas: "#F6F2EA",
      surface: "#FFFDF9",
      surfaceAlt: "#EBE5D8",
      darkStart: "#162926",
      darkEnd: "#223E39",
      footerBg: "#101E1C",
      primary: "#285247",
      primaryHover: "#1E3F36",
      primaryInk: "#FFFFFF",
      accent: "#B88642",
      accentHover: "#9D6F31",
      accentInk: "#FFFFFF",
      accentSoft: "rgba(184, 134, 66, 0.16)",
      ink: "#1D2622",
      inkMuted: "#4F5D56",
      darkInk: "#F5F3EE",
      darkInkMuted: "#C7D6D1",
      border: "#DDD5C6",
      darkBorder: "rgba(196, 166, 114, 0.26)",
      glowA: "rgba(74, 140, 120, 0.20)",
      glowB: "rgba(184, 134, 66, 0.16)",
    },
    swatches: [
      { label: "Parchment", role: "Canvas", hex: "#F6F2EA" },
      { label: "Cream", role: "Surface", hex: "#FFFDF9" },
      { label: "Apothecary", role: "Dark Band", hex: "#162926" },
      { label: "Botanical", role: "Primary", hex: "#285247" },
      { label: "Burnished Ochre", role: "Accent", hex: "#B88642" },
      { label: "Forest Ink", role: "Text", hex: "#1D2622" },
    ],
  },
  {
    id: "crepusculo",
    name: "Crepúsculo Sobrio",
    subtitle: "Muted Twilight Indigo & Champagne",
    vibe: "Evolución pulida de la paleta actual · Mística contenida",
    rationale:
      "Mantiene el ADN violeta-índigo original del sitio, pero baja la saturación y reemplaza el naranja fuerte por champaña suave para que respire lujo sereno.",
    tokens: {
      canvas: "#F6F5F9",
      surface: "#FFFFFF",
      surfaceAlt: "#ECE9F3",
      darkStart: "#1A162B",
      darkEnd: "#2C2447",
      footerBg: "#120F1F",
      primary: "#4B3E7A",
      primaryHover: "#3B3063",
      primaryInk: "#FFFFFF",
      accent: "#C5A467",
      accentHover: "#AD8C4F",
