      { label: "Pearl Mist", role: "Canvas", hex: "#F6F5F9" },
      { label: "White", role: "Surface", hex: "#FFFFFF" },
      { label: "Obsidian Plum", role: "Dark Band", hex: "#1A162B" },
      { label: "Twilight", role: "Primary", hex: "#4B3E7A" },
      { label: "Champagne", role: "Accent", hex: "#C5A467" },
      { label: "Deep Violet", role: "Text", hex: "#211C33" },
    ],
  },
  {
    id: "editorial",
    name: "Editorial Minimal",
    subtitle: "Obsidian, Warm Stone & Brass Hairline",
    vibe: "Monografía de lujo · Máxima legibilidad · Atemporal",
    rationale:
      "Neutralidad casi total para que las fotografías astronómicas, el retrato de Glenda y las miniaturas de YouTube lleven todo el peso cromático sin fricción.",
    tokens: {
      canvas: "#F4F2EE",
      surface: "#FFFFFF",
      surfaceAlt: "#E9E5DD",
      darkStart: "#151517",
      darkEnd: "#242327",
      footerBg: "#0E0E10",
      primary: "#1C1B1A",
      primaryHover: "#312F2D",
      primaryInk: "#FFFFFF",
      accent: "#B5945B",
      accentHover: "#9B7C45",
      accentInk: "#FFFFFF",
      accentSoft: "rgba(181, 148, 91, 0.16)",
      ink: "#171717",
      inkMuted: "#57534E",
      darkInk: "#FAF8F4",
      darkInkMuted: "#CBC7BF",
      border: "#DFDBD2",
      darkBorder: "rgba(181, 148, 91, 0.28)",
      glowA: "rgba(255, 255, 255, 0.06)",
      glowB: "rgba(181, 148, 91, 0.14)",
    },
    swatches: [
      { label: "Warm Stone", role: "Canvas", hex: "#F4F2EE" },
      { label: "Paper", role: "Surface", hex: "#FFFFFF" },
      { label: "Obsidian", role: "Dark Band", hex: "#151517" },
      { label: "Charcoal", role: "Primary", hex: "#1C1B1A" },
