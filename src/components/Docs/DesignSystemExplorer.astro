---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<div
  id="ds-explorer"
  class="ds-explorer"
  data-theme="astrolabio"
  data-typo="paired"
  data-cta-surface="dark"
>
  <!-- Sticky Control Bar -->
  <section
    class="ds-controls sticky top-20 z-30 rounded-2xl border border-gray-200 bg-white/95 p-4 md:p-5 shadow-lg backdrop-blur-md mb-8"
  >
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-widest text-gray-500"
            style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            Explorador Interactivo · Selecciona una dirección visual
          </p>
        </div>
        <div
          class="flex flex-wrap items-center gap-2"
          style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
        >
          <!-- Typography Mode Toggle -->
          <div
            class="inline-flex rounded-lg border border-gray-200 bg-gray-100 p-1 text-xs"
            role="group"
            aria-label="Modo tipográfico"
          >
            <button
              type="button"
              data-typo-btn="paired"
              class="ds-toggle-btn is-active rounded-md px-3 py-1.5 font-medium transition-colors cursor-pointer"
            >
              Serif + Sans UI
            </button>
            <button
              type="button"
              data-typo-btn="all-serif"
              class="ds-toggle-btn rounded-md px-3 py-1.5 font-medium transition-colors cursor-pointer"
            >
              All Serif (actual)
            </button>
          </div>

          <!-- CTA Surface Variant Toggle -->
          <div
            class="inline-flex rounded-lg border border-gray-200 bg-gray-100 p-1 text-xs"
            role="group"
            aria-label="Estilo de tarjeta CTA"
          >
            <button
              type="button"
              data-cta-btn="dark"
              class="ds-toggle-btn is-active rounded-md px-3 py-1.5 font-medium transition-colors cursor-pointer"
            >
              CTA Oscuro
            </button>
            <button
              type="button"
              data-cta-btn="light"
              class="ds-toggle-btn rounded-md px-3 py-1.5 font-medium transition-colors cursor-pointer"
            >
              CTA Editorial Claro
            </button>
          </div>
        </div>
      </div>

      <!-- 4 Theme Cards -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3"
        style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
      >
        {
          themes.map((theme, idx) => (
            <button
              type="button"
              data-theme-btn={theme.id}
              class:list={[
                "ds-theme-card text-left rounded-xl border-2 p-3.5 transition-all cursor-pointer",
                idx === 0
                  ? "is-active border-gray-900 bg-gray-50 shadow-sm"
                  : "border-gray-200 bg-white hover:border-gray-400",
              ]}
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center -space-x-1">
                  <span
                    class="h-4 w-4 rounded-full border border-white shadow-xs"
                    style={`background:${theme.tokens.canvas}`}
                  />
                  <span
                    class="h-4 w-4 rounded-full border border-white shadow-xs"
                    style={`background:${theme.tokens.darkStart}`}
                  />
                  <span
                    class="h-4 w-4 rounded-full border border-white shadow-xs"
                    style={`background:${theme.tokens.primary}`}
                  />
                  <span
                    class="h-4 w-4 rounded-full border border-white shadow-xs"
                    style={`background:${theme.tokens.accent}`}
                  />
                </div>
                {theme.recommended && (
                  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-900">
                    Sugerida
                  </span>
                )}
              </div>
              <div class="text-sm font-bold text-gray-900">{theme.name}</div>
              <div class="text-xs text-gray-500 mt-0.5">{theme.subtitle}</div>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Active Theme Rationale + Swatches -->
  <section
    class="rounded-2xl border border-gray-200 bg-white p-6 md:p-8 shadow-sm mb-10"
  >
    {
      themes.map((theme) => (
        <div data-theme-panel={theme.id} class="ds-theme-panel">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-gray-200">
            <div>
              <p
                class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-1"
                style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {theme.vibe}
              </p>
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
                {theme.name}
              </h2>
              <p
                class="mt-2 text-sm md:text-base text-gray-600 max-w-2xl"
                style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {theme.rationale}
              </p>
            </div>
            <div
              class="text-xs text-gray-500 shrink-0"
              style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
            >
              Haz clic en cualquier paleta arriba para comparar en vivo
            </div>
          </div>

          <div
            class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 pt-6"
            style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            {theme.swatches.map((swatch) => (
              <div class="rounded-xl border border-gray-200 overflow-hidden bg-white">
                <div
                  class="h-16 w-full border-b border-gray-100"
                  style={`background:${swatch.hex}`}
                />
                <div class="p-3">
                  <div class="text-xs font-semibold text-gray-900">
                    {swatch.label}
                  </div>
                  <div class="text-[11px] text-gray-500">{swatch.role}</div>
                  <code class="mt-1 inline-block text-[11px] font-mono text-gray-700">
                    {swatch.hex}
                  </code>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Live Site Sandbox: Real Components with Active Tokens -->
  <section
    class="ds-sandbox rounded-3xl overflow-hidden border shadow-xl mb-10"
  >
    <!-- Simulated Site Header -->
    <div
      class="ds-surface border-b px-6 md:px-10 py-4 flex items-center justify-between"
    >
      <span class="ds-display text-2xl font-bold tracking-tight">
        Glenda Ferreira
      </span>
      <nav class="ds-ui hidden sm:flex items-center gap-6 text-sm font-medium">
        <span class="opacity-70">Inicio</span>
        <span class="ds-nav-active pb-0.5 font-semibold">Videos</span>
        <span class="opacity-70">Contacto</span>
      </nav>
    </div>

    <!-- 1. Mini Hero with Real Night Sky Asset -->
    <div class="relative overflow-hidden px-6 md:px-12 py-16 md:py-20">
      <img
        src="https://res.cloudinary.com/dvhwjf1zd/image/upload/v1758152929/Glenda%20Ferreira/image-asset_zlvc49.webp"
        alt="Cielo estrellado sobre montañas"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="ds-hero-scrim absolute inset-0" aria-hidden="true"></div>
      <div class="relative z-10 max-w-2xl">
        <p
          class="ds-ui ds-dark-pill inline-flex items-center rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-widest mb-4"
        >
          Astrología Médica & Tradicional
        </p>
        <h3
          class="ds-display text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight"
        >
          Tu Carta Natal Como Herramienta de Comprensión
        </h3>
        <p class="ds-ui ds-dark-muted mt-4 text-base md:text-lg leading-relaxed">
          Consultas presenciales y online con la Dra. Glenda Ferreira, médica
          cirujana y astróloga con formación en astrología médica tradicional.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#ds-cta-preview" class="ds-btn ds-btn-accent ds-ui">
            Reserva una lectura →
          </a>
          <a href="#ds-cta-preview" class="ds-btn ds-btn-ghost-dark ds-ui">
            Explorar videos
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Video Cards & Buttons on Canvas Surface -->
    <div class="ds-canvas px-6 md:px-12 py-14">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p
          class="ds-ui ds-accent-text text-xs font-semibold uppercase tracking-widest mb-2"
        >
          Biblioteca de Videos
        </p>
        <h3 class="ds-display ds-ink text-3xl md:text-4xl font-bold">
          Videos Destacados
        </h3>
        <p class="ds-ui ds-ink-muted mt-2 text-base">
          Así conviven las tarjetas claras sobre el fondo principal antes de
          llegar al bloque de lectura personal.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <article
          class="ds-surface ds-border rounded-2xl border overflow-hidden shadow-sm flex flex-col"
        >
          <div class="relative aspect-video bg-gray-900 overflow-hidden">
            <img
              src="https://img.youtube.com/vi/ohmv0HEbS8U/hqdefault.jpg"
              alt="Astrología Médica: La Decumbitura"
              class="h-full w-full object-cover opacity-90"
            />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h4 class="ds-display ds-ink text-2xl font-bold leading-snug">
              Astrología Médica: La Decumbitura
            </h4>
            <p class="ds-ui ds-ink-muted text-sm mt-2 leading-relaxed flex-grow">
              Conversación con la Dra. Glenda Ferreira sobre decumbitura,
              técnicas de astrología médica tradicional y análisis de salud.
            </p>
            <div class="mt-5">
              <span class="ds-btn ds-btn-primary ds-ui w-full text-center">
                Ver Video
              </span>
            </div>
          </div>
        </article>

        <!-- Typography & Button System Card -->
        <div
          class="ds-surface ds-border rounded-2xl border p-6 shadow-sm flex flex-col justify-between gap-6"
        >
          <div>
            <p
              class="ds-ui ds-accent-text text-xs font-semibold uppercase tracking-widest mb-3"
            >
              Botones sobre fondo claro
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="ds-btn ds-btn-primary ds-ui">Primary</span>
              <span class="ds-btn ds-btn-accent ds-ui">Accent</span>
              <span class="ds-btn ds-btn-outline-light ds-ui">Outline</span>
            </div>
          </div>

          <div class="pt-5 ds-border border-t">
            <p
              class="ds-ui ds-accent-text text-xs font-semibold uppercase tracking-widest mb-2"
            >
              Cita Editorial
            </p>
            <blockquote
              class="ds-display ds-ink text-xl italic leading-relaxed"
            >
              “La medicina me enseñó el cómo funciona el cuerpo; la astrología
              me enseñó el por qué nos sucede lo que nos sucede.”
            </blockquote>
            <p class="ds-ui ds-ink-muted text-xs font-medium mt-2">
              — Dra. Glenda Ferreira, M.D.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Personal Reading CTA Preview (Switches between Dark Card & Editorial Light Card) -->
    <div id="ds-cta-preview" class="ds-surface-alt px-6 md:px-12 py-16">
      <div class="max-w-4xl mx-auto">
        <!-- Dark CTA Variant -->
        <div
          class="ds-cta-dark relative overflow-hidden rounded-3xl px-6 py-12 sm:px-12 md:py-14 text-center shadow-2xl border"
        >
          <div class="ds-glow-a pointer-events-none" aria-hidden="true"></div>
          <div class="ds-glow-b pointer-events-none" aria-hidden="true"></div>

          <div class="relative z-10 mx-auto max-w-2xl">
            <div
              class="mb-5 flex items-center justify-center gap-4"
              aria-hidden="true"
            >
              <span class="ds-divider-line-left h-px w-12"></span>
              <svg
                class="ds-accent-icon h-4 w-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z"
                ></path>
              </svg>
              <span class="ds-divider-line-right h-px w-12"></span>
            </div>

            <p
              class="ds-ui ds-dark-pill mb-4 inline-flex items-center rounded-full px-4 py-1 text-xs font-semibold uppercase tracking-widest"
            >
              Consulta Personalizada
            </p>

            <h3
              class="ds-display ds-dark-ink text-3xl sm:text-4xl md:text-5xl font-bold leading-tight"
            >
              ¿Prefieres una lectura personal?
            </h3>

            <p
              class="ds-ui ds-dark-muted mt-4 text-base sm:text-lg leading-relaxed max-w-xl mx-auto"
            >
              Lleva estas herramientas a tu propia carta natal. Agenda una
              sesión privada con la Dra. Glenda Ferreira y recibe claridad
              práctica para tu momento actual.
            </p>

            <div
              class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5"
            >
              <span class="ds-btn ds-btn-accent ds-ui w-full sm:w-auto">
                Agenda una sesión →
              </span>
              <span class="ds-btn ds-btn-ghost-dark ds-ui w-full sm:w-auto">
                Ver opciones de contacto
              </span>
            </div>

            <ul
              class="ds-ui ds-dark-muted ds-dark-border mt-9 pt-7 border-t flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5 text-sm"
            >
              <li class="inline-flex items-center gap-2">
                <span class="ds-accent-icon">✦</span>
                <span>En línea vía Zoom</span>
              </li>
              <li class="inline-flex items-center gap-2">
                <span class="ds-accent-icon">✦</span>
                <span>Sesión grabada en HD</span>
              </li>
              <li class="inline-flex items-center gap-2">
                <span class="ds-accent-icon">✦</span>
                <span>Español e inglés</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Light Editorial CTA Variant -->
        <div
          class="ds-cta-light ds-surface ds-border relative overflow-hidden rounded-3xl px-6 py-12 sm:px-12 md:py-14 text-center shadow-lg border"
        >
          <div class="relative z-10 mx-auto max-w-2xl">
            <div
              class="mb-5 flex items-center justify-center gap-4"
              aria-hidden="true"
            >
              <span class="ds-divider-line-left h-px w-12"></span>
              <svg
                class="ds-accent-icon h-4 w-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z"
                ></path>
              </svg>
              <span class="ds-divider-line-right h-px w-12"></span>
            </div>

            <p
              class="ds-ui ds-light-pill mb-4 inline-flex items-center rounded-full px-4 py-1 text-xs font-semibold uppercase tracking-widest"
            >
              Consulta Personalizada
            </p>

            <h3
