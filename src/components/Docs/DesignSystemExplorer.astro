<script>
  const explorer = document.getElementById("ds-explorer");
  if (explorer) {
    const themeButtons =
      explorer.querySelectorAll<HTMLButtonElement>("[data-theme-btn]");
    const typoButtons =
      explorer.querySelectorAll<HTMLButtonElement>("[data-typo-btn]");
    const ctaButtons =
      explorer.querySelectorAll<HTMLButtonElement>("[data-cta-btn]");

    const setActiveTheme = (themeId: string) => {
      explorer.dataset.theme = themeId;
      themeButtons.forEach((btn) => {
        const active = btn.dataset.themeBtn === themeId;
        btn.classList.toggle("is-active", active);
        btn.classList.toggle("border-gray-900", active);
        btn.classList.toggle("bg-gray-50", active);
        btn.classList.toggle("shadow-sm", active);
        btn.classList.toggle("border-gray-200", !active);
        btn.classList.toggle("bg-white", !active);
      });
    };

    const setActiveTypo = (mode: string) => {
      explorer.dataset.typo = mode;
      typoButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.typoBtn === mode);
      });
    };

    const setActiveCtaSurface = (surface: string) => {
      explorer.dataset.ctaSurface = surface;
      ctaButtons.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.ctaBtn === surface);
      });
    };

    themeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.themeBtn) setActiveTheme(btn.dataset.themeBtn);
      });
    });

    typoButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.typoBtn) setActiveTypo(btn.dataset.typoBtn);
      });
    });

    ctaButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.ctaBtn) setActiveCtaSurface(btn.dataset.ctaBtn);
      });
    });
  }
</script>

