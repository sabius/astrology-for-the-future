---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "accent" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  disabled = false,
  type = "button",
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = [
  "inline-flex items-center justify-center gap-2",
  "font-sans font-semibold uppercase tracking-[0.18em]",
  "border rounded-[2px]",
  "transition-all duration-300 ease-in-out",
  "focus:outline-none focus:ring-2 focus:ring-gold/60 focus:ring-offset-2 focus:ring-offset-bg-900",
  "disabled:opacity-50 disabled:cursor-not-allowed",
  "min-h-[44px]", // Mobile touch target
];

const sizeStyles = {
  sm: "px-7 py-3 text-[11px]",
  md: "px-9 py-4 text-xs",
  lg: "px-11 py-4 text-xs",
};

const variantStyles = {
  // Solid gold — primary CTA
  primary: [
    "bg-gold text-ink border-gold",
    "shadow-[0_14px_40px_rgba(201,162,39,0.3)]",
    "hover:bg-gold-light hover:border-gold-light hover:-translate-y-0.5",
  ].join(" "),
  // Tinted gold — secondary
  secondary: [
    "bg-gold/10 text-gold-light border-gold/30",
    "hover:bg-gold/15 hover:border-gold/50 hover:-translate-y-0.5",
  ].join(" "),
  // Gold outline
  accent: [
    "bg-transparent text-gold-light border-gold/55",
    "hover:bg-gold hover:text-ink hover:border-gold",
  ].join(" "),
  outline: [
    "bg-transparent text-gold-light border-gold/55",
    "hover:bg-gold hover:text-ink hover:border-gold",
  ].join(" "),
};

const classes = [
  ...baseStyles,
  sizeStyles[size],
  variantStyles[variant],
  className,
].join(" ");

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class={classes}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : rel}
  disabled={disabled}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  role={!href ? "button" : undefined}
  {...rest}
>
  <slot />
</Element>

<style>
  /* Ensure proper touch target size on mobile */
  @media (max-width: 640px) {
    a,
    button {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
