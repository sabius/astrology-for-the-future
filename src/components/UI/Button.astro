---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "accent" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  disabled = false,
  type = "button",
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = [
  "inline-flex items-center justify-center gap-2",
  "font-sans text-sm sm:text-base font-semibold tracking-normal",
  "border rounded-xl",
  "transition-all duration-300 ease-in-out",
  "focus:outline-none focus:ring-2 focus:ring-offset-2",
  "disabled:opacity-50 disabled:cursor-not-allowed",
  "min-h-[44px] min-w-[44px]",
  "transform hover:-translate-y-0.5 active:translate-y-0",
];

const sizeStyles = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3",
  lg: "px-7 py-3.5 text-base",
};

const variantStyles = {
  primary: [
    "bg-primary-800 text-white border-primary-800",
    "hover:bg-primary-900 hover:border-primary-900",
    "active:bg-primary-950",
    "focus:ring-primary-500",
    "shadow-sm hover:shadow-md",
  ].join(" "),
  secondary: [
    "bg-primary-700 text-white border-primary-700",
    "hover:bg-primary-800 hover:border-primary-800",
    "active:bg-primary-900",
    "focus:ring-primary-500",
    "shadow-sm hover:shadow-md",
  ].join(" "),
  accent: [
    "bg-accent-500 text-white border-accent-500",
    "hover:bg-accent-600 hover:border-accent-600",
    "active:bg-accent-700",
    "focus:ring-accent-400",
    "shadow-md hover:shadow-lg",
  ].join(" "),
  outline: [
    "bg-surface text-primary-900 border-border-subtle",
    "hover:bg-surface-alt hover:text-primary-950 hover:border-primary-300",
    "active:bg-primary-50",
    "focus:ring-primary-500",
    "shadow-xs hover:shadow-sm",
  ].join(" "),
  ghost: [
    "bg-white/10 text-white border-accent-300/35 backdrop-blur-sm",
    "hover:bg-white/20 hover:border-accent-300/60",
    "active:bg-white/25",
    "focus:ring-accent-300",
  ].join(" "),
};

const classes = [
  ...baseStyles,
  sizeStyles[size],
  variantStyles[variant],
  className,
].join(" ");

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class={classes}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : rel}
  disabled={disabled}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  role={!href ? "button" : undefined}
  {...rest}
>
  <slot />
</Element>

<style>
  @media (max-width: 640px) {
    a,
    button {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
