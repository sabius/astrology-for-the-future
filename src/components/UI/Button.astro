---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "accent" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  showChannelIcon?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  disabled = false,
  type = "button",
  ariaLabel,
  showChannelIcon = true,
  ...rest
} = Astro.props;

const isWhatsAppUrl =
  typeof href === "string" &&
  /(?:^https?:\/\/)?(?:www\.|api\.)?(?:wa\.me|whatsapp\.com)(?:[/?#]|$)/i.test(
    href
  );

const showWhatsAppIcon = showChannelIcon && isWhatsAppUrl;

const baseStyles = [
  "inline-flex items-center justify-center gap-2",
  "font-sans text-sm sm:text-base font-semibold tracking-normal",
  "border rounded-xl",
  "transition-all duration-300 ease-in-out",
  "focus:outline-none focus:ring-2 focus:ring-offset-2",
  "disabled:opacity-50 disabled:cursor-not-allowed",
  "min-h-[44px] min-w-[44px]",
  "transform hover:-translate-y-0.5 active:translate-y-0",
];

const sizeStyles = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3",
  lg: "px-7 py-3.5 text-base",
};

const iconSizeStyles = {
  sm: "h-4 w-4",
  md: "h-5 w-5",
  lg: "h-5 w-5",
};

const variantStyles = {
  primary: [
    "bg-primary-800 text-white border-primary-800",
    "hover:bg-primary-900 hover:border-primary-900",
    "active:bg-primary-950",
    "focus:ring-primary-500",
    "shadow-sm hover:shadow-md",
  ].join(" "),
  secondary: [
    "bg-primary-700 text-white border-primary-700",
    "hover:bg-primary-800 hover:border-primary-800",
    "active:bg-primary-900",
    "focus:ring-primary-500",
    "shadow-sm hover:shadow-md",
  ].join(" "),
  accent: [
    "bg-accent-500 text-white border-accent-500",
    "hover:bg-accent-600 hover:border-accent-600",
    "active:bg-accent-700",
    "focus:ring-accent-400",
    "shadow-md hover:shadow-lg",
  ].join(" "),
  outline: [
    "bg-surface text-primary-900 border-border-subtle",
    "hover:bg-surface-alt hover:text-primary-950 hover:border-primary-300",
    "active:bg-primary-50",
    "focus:ring-primary-500",
    "shadow-xs hover:shadow-sm",
  ].join(" "),
  ghost: [
    "bg-white/10 text-white border-accent-300/35 backdrop-blur-sm",
    "hover:bg-white/20 hover:border-accent-300/60",
    "active:bg-white/25",
    "focus:ring-accent-300",
  ].join(" "),
};

const classes = [
  ...baseStyles,
  sizeStyles[size],
  variantStyles[variant],
  className,
].join(" ");

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class={classes}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : rel}
  disabled={disabled}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  role={!href ? "button" : undefined}
  {...rest}
>
  {
    showWhatsAppIcon && (
      <svg
        class:list={["shrink-0", iconSizeStyles[size]]}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
      </svg>
    )
  }
  <slot />
  {showWhatsAppIcon && !ariaLabel && <span class="sr-only"> (WhatsApp)</span>}
</Element>

<style>
  @media (max-width: 640px) {
    a,
    button {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
