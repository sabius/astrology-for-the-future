---
import Button from "../UI/Button.astro";

type ButtonVariant = "primary" | "secondary" | "accent" | "outline" | "ghost";

interface CtaButton {
  text: string;
  url: string;
  style?: ButtonVariant;
}

export interface Props {
  eyebrow?: string;
  header?: string;
  copy?: string;
  button: CtaButton;
  secondary_button?: CtaButton;
  highlights?: string[];
}

const { eyebrow, header, copy, button, secondary_button, highlights } =
  Astro.props as Props;

const allowedVariants = new Set<ButtonVariant>([
  "primary",
  "secondary",
  "accent",
  "outline",
  "ghost",
]);

const resolveVariant = (
  style: string | undefined,
  fallback: ButtonVariant
): ButtonVariant =>
  style && allowedVariants.has(style as ButtonVariant)
    ? (style as ButtonVariant)
    : fallback;

const isExternalUrl = (url: string) =>
  url.startsWith("http://") ||
  url.startsWith("https://") ||
  url.includes("wa.me");

const primaryVariant = resolveVariant(button?.style, "accent");
const secondaryVariant = resolveVariant(secondary_button?.style, "ghost");
---

<section class="py-16 md:py-24 px-4 sm:px-6 bg-surface-alt">
  <div class="container max-w-5xl">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 px-6 py-12 sm:px-12 md:px-16 md:py-16 text-center shadow-2xl border border-accent-300/25"
    >
      <!-- Ambient celestial glows -->
      <div
        class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-primary-400/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-accent-500/15 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-3xl">
        <!-- Subtle celestial ornament -->
        <div
          class="mb-6 flex items-center justify-center gap-4"
          aria-hidden="true"
        >
          <span
            class="h-px w-12 bg-gradient-to-r from-transparent to-accent-300/70"
          ></span>
          <svg
            class="h-4 w-4 text-accent-400"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z"
            ></path>
          </svg>
          <span
            class="h-px w-12 bg-gradient-to-l from-transparent to-accent-300/70"
          ></span>
        </div>

        {
          eyebrow && (
            <p class="mb-4 inline-flex items-center rounded-full border border-accent-300/30 bg-white/10 px-4 py-1 text-xs sm:text-sm font-semibold uppercase tracking-widest text-primary-100 backdrop-blur-sm">
              {eyebrow}
            </p>
          )
        }

        {
          header && (
            <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight tracking-tight">
              {header}
            </h2>
          )
        }

        {
          copy && (
            <p class="mt-5 text-base sm:text-lg md:text-xl text-primary-200 max-w-2xl mx-auto leading-relaxed">
              {copy}
            </p>
          )
        }

        {
          (button || secondary_button) && (
            <div class="mt-8 md:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
              {button && (
                <Button
                  href={button.url}
                  target={isExternalUrl(button.url) ? "_blank" : undefined}
                  variant={primaryVariant}
                  size="lg"
                  class="group w-full sm:w-auto"
                >
                  <span>{button.text}</span>
                  <svg
                    class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                    />
                  </svg>
                </Button>
              )}

              {secondary_button && (
                <Button
                  href={secondary_button.url}
                  target={
                    isExternalUrl(secondary_button.url) ? "_blank" : undefined
                  }
                  variant={secondaryVariant}
                  size="lg"
                  class="w-full sm:w-auto"
                >
                  {secondary_button.text}
                </Button>
              )}
            </div>
          )
        }

        {
          highlights && highlights.length > 0 && (
            <ul class="mt-10 pt-8 border-t border-accent-300/20 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm sm:text-base text-primary-200">
              {highlights.map((item) => (
                <li class="inline-flex items-center gap-2">
                  <svg
                    class="h-3.5 w-3.5 text-accent-400 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2L14.6 9.4L22 12L14.6 14.6L12 22L9.4 14.6L2 12L9.4 9.4L12 2Z" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>
