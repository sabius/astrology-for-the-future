---
import { marked } from "marked";
import DOMPurify from "isomorphic-dompurify";

import Button from "../UI/Button.astro";
import ResponsivePicture from "../UI/ResponsivePicture.astro";

const { header, copy, image, image_alt, list_items, button } = Astro.props;
---

<!-- Map Section -->
<section class="feature-card py-16 md:py-20">
  <div class="container">
    {
      (header || copy) && (
        <div class="text-center mb-14">
          {header && <h2 class="text-3xl md:text-5xl font-bold text-primary-900">{header}</h2>}
          {copy && (
            <p class="mt-3 text-base sm:text-lg md:text-xl text-ink-muted max-w-2xl mx-auto leading-relaxed">{copy}</p>
          )}
        </div>
      )
    }

    <div
      class:list={[
        "grid gap-8 items-center",
        image ? "grid-cols-1 md:grid-cols-2" : "grid-cols-1 max-w-3xl mx-auto",
      ]}
    >
      {
        image && (
          <div class="bg-surface-alt border border-border-subtle rounded-2xl overflow-hidden aspect-square max-w-md mx-auto w-full shadow-md">
            <ResponsivePicture
              src={image}
              alt={image_alt}
              imageClass="w-full h-full object-cover object-center"
            />
          </div>
        )
      }

      <div class:list={[!image && "text-center flex flex-col items-center"]}>
        <div class="bg-surface border border-border-subtle p-8 md:p-10 rounded-2xl shadow-sm w-full space-y-4">
          {
            list_items &&
              list_items.map(async (card_item: { heading?: string; copy?: string }) => {
                const rawCardHtml = await marked.parse(card_item.copy ?? "");
                const cleanCardHtml = DOMPurify.sanitize(rawCardHtml);

                return (
                  <div>
                    {card_item.heading && (
                      <h4 class="font-bold text-2xl text-primary-900 mb-2">
                        {card_item.heading}
                      </h4>
                    )}
                    {card_item.copy && (
                      <div
                        class="text-ink-muted text-base md:text-lg leading-relaxed"
                        set:html={cleanCardHtml}
                      />
                    )}
                  </div>
                );
              })
          }
        </div>

        {
          button && (
            <div class="mt-6">
              <Button
                href={button.url}
                target="_blank"
                variant={button.style ?? "primary"}
              >
                {button.text}
              </Button>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
