---
const { quote, author } = Astro.props;
---

{
  quote && (
    <section class="section-quote py-20 px-4 bg-canvas border-t border-border-subtle">
      <div class="container">
        <figure class="mx-auto max-w-4xl text-center">
          <div
            class="mb-6 flex items-center justify-center gap-4"
            aria-hidden="true"
          >
            <span class="h-px w-10 bg-gradient-to-r from-transparent to-accent-400/70" />
            <svg
              class="h-4 w-4 text-accent-500"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z" />
            </svg>
            <span class="h-px w-10 bg-gradient-to-l from-transparent to-accent-400/70" />
          </div>

          <blockquote class="font-serif text-2xl md:text-3xl leading-relaxed italic text-primary-900">
            <span class="block">“{quote}”</span>
          </blockquote>

          {author && (
            <figcaption class="mt-8 font-sans text-sm md:text-base font-semibold uppercase tracking-widest text-accent-700">
              — {author}
            </figcaption>
          )}
        </figure>
      </div>
    </section>
  )
}
