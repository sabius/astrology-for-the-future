---
import ResponsivePicture from "../UI/ResponsivePicture.astro";

const { quote, author, background_image } = Astro.props;
---

{
  quote && (
    <section data-reveal class="relative overflow-hidden">
      {background_image ? (
        <ResponsivePicture
          src={background_image}
          alt=""
          class="absolute inset-0 block h-full w-full"
          imageClass="h-full w-full object-cover [filter:brightness(.42)_saturate(.85)]"
          type="hero"
        />
      ) : (
        <div class="absolute inset-0 bg-bg-panel" aria-hidden="true" />
      )}
      <div
        class="absolute inset-0"
        style="background:linear-gradient(180deg,rgba(6,11,19,.72),rgba(6,11,19,.88));"
        aria-hidden="true"
      />
      <div class="relative mx-auto max-w-3xl px-6 py-28 text-center md:py-32">
        <div class="mb-4 font-serif text-3xl text-gold">✦</div>
        <blockquote class="m-0 font-serif text-[clamp(24px,3.2vw,40px)] font-normal italic leading-[1.4] text-ivory-300">
          “{quote}”
        </blockquote>
        {author && (
          <div class="mt-8 text-xs uppercase tracking-[0.26em] text-gold">
            {author}
          </div>
        )}
      </div>
    </section>
  )
}
