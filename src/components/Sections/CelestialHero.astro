---
import Button from "../UI/Button.astro";

type ButtonVariant = "primary" | "secondary" | "accent" | "outline" | "ghost";

interface HeroButton {
  text: string;
  url: string;
  style?: ButtonVariant;
}

export interface Props {
  hidden_h1?: string;
  eyebrow?: string;
  header?: string;
  copy?: string;
  compact?: boolean;
  button?: HeroButton;
  secondary_button?: HeroButton;
  highlights?: string[];
}

const {
  hidden_h1,
  eyebrow,
  header,
  copy,
  compact = false,
  button,
  secondary_button,
  highlights = [],
} = Astro.props as Props;

const isExternalUrl = (url: string) =>
  url.startsWith("http://") ||
  url.startsWith("https://") ||
  url.includes("wa.me");
---

<celestial-hero-canvas class="block">
  <section
    data-hero-stage
    class:list={[
      "celestial-hero relative flex items-center bg-midnight text-white overflow-hidden border-b border-accent-300/20",
      compact
        ? "min-h-[46vh] lg:min-h-[52vh]"
        : "min-h-[78vh] lg:min-h-[82vh]",
    ]}
  >
    {hidden_h1 && <h1 class="sr-only">{hidden_h1}</h1>}

    <!-- Interactive HiDPI HTML5 Canvas Backdrop -->
    <canvas
      data-hero-canvas
      class="absolute inset-0 h-full w-full block"
      aria-hidden="true"></canvas>

    <!-- Editorial Content Column -->
    <div
      class:list={[
        "container relative z-10 px-4 sm:px-6 pointer-events-none",
        compact
          ? "py-14 sm:py-16 lg:py-20"
          : "py-16 sm:py-20 lg:py-24",
      ]}
    >
      <div class="max-w-2xl">
        {
          eyebrow && (
            <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-300/30 bg-midnight/50 px-4 py-1.5 text-xs sm:text-sm font-semibold uppercase tracking-widest text-accent-200 backdrop-blur-sm">
              <svg
                class="h-3.5 w-3.5 text-accent-400 flex-shrink-0"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z" />
              </svg>
              <span>{eyebrow}</span>
            </p>
          )
        }

        {
          header &&
            (hidden_h1 ? (
              <p class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight tracking-tight">
                {header}
              </p>
            ) : (
              <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight tracking-tight">
                {header}
              </h1>
            ))
        }

        {
          copy && (
            <p class="mt-5 text-base sm:text-lg md:text-xl text-primary-200 max-w-xl leading-relaxed">
              {copy}
            </p>
          )
        }

        {
          (button || secondary_button) && (
            <div class="mt-8 md:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pointer-events-auto">
              {button && (
                <Button
                  href={button.url}
                  target={isExternalUrl(button.url) ? "_blank" : undefined}
                  variant={button.style ?? "accent"}
                  size="lg"
                  class="group"
                >
                  <span>{button.text}</span>
                  <svg
                    class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                    />
                  </svg>
                </Button>
              )}

              {secondary_button && (
                <Button
                  href={secondary_button.url}
                  target={
                    isExternalUrl(secondary_button.url) ? "_blank" : undefined
                  }
                  variant={secondary_button.style ?? "ghost"}
                  size="lg"
                >
                  {secondary_button.text}
                </Button>
              )}
            </div>
          )
        }

        {
          highlights.length > 0 && (
            <ul class="mt-10 pt-6 border-t border-accent-300/20 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-sm text-primary-200 max-w-xl">
              {highlights.map((item) => (
                <li class="inline-flex items-center gap-2">
                  <svg
                    class="h-3 w-3 text-accent-400 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2L14.6 9.4L22 12L14.6 14.6L12 22L9.4 14.6L2 12L9.4 9.4L12 2Z" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <!-- Subtle Bottom Scroll Hairline Cue (desktop, flagship only) -->
    {
      !compact && (
        <div
          class="hidden lg:flex absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex-col items-center gap-2 pointer-events-none"
          aria-hidden="true"
        >
          <span class="h-8 w-px bg-gradient-to-b from-accent-300/60 to-transparent" />
        </div>
      )
    }
  </section>
</celestial-hero-canvas>

<script src="../Lit/CelestialHeroCanvas.ts"></script>
