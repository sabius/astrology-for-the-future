---
import ResponsivePicture from "../UI/ResponsivePicture.astro";

const { header, copy, columns = [], background_color = "" } = Astro.props;

const normalizedColumns = columns.slice(0, 2).map((column) => ({
  ...column,
  items:
    column?.items?.map((item) => ({
      ...item,
      copySegments: Array.isArray(item?.copy)
        ? item.copy
        : item?.copy
          ? [item.copy]
          : [],
    })) ?? [],
}));
---

<section
  class="px-6 py-12 md:py-20 lg:py-24"
  style={{ backgroundColor: background_color ?? "" }}
>
  <div class="container">
    {
      (header || copy) && (
        <div class="text-center mb-16">
          {header && (
            <h2 class="font-serif text-[clamp(32px,4.2vw,56px)] font-medium text-ivory-200">
              {header}
            </h2>
          )}
          {copy && (
            <p class="text-lg font-light text-muted max-w-2xl mx-auto">{copy}</p>
          )}
        </div>
      )
    }
  </div>
  <div
    class:list={[
      "grid w-full max-w-5xl mx-auto gap-10 md:gap-14",
      normalizedColumns.length > 1
        ? "grid-cols-1 md:grid-cols-2"
        : "grid-cols-1 max-w-3xl",
    ]}
  >
    {
      normalizedColumns.map((column) => (
        <div class="flex flex-col gap-10 md:gap-14">
          {column.items?.map((item) =>
            item?.image ? (
              <figure class="flex flex-col gap-4">
                <ResponsivePicture
                  src={item.image}
                  alt={item.image_alt ?? ""}
                  class="overflow-hidden rounded-[32px] shadow-md"
                  imageClass="h-full w-full object-cover"
                />
                {item?.legend && (
                  <figcaption class="text-sm leading-relaxed text-muted md:text-base">
                    {item.legend}
                  </figcaption>
                )}
              </figure>
            ) : (
              <article
                class:list={[
                  "flex flex-col gap-4 text-body",
                  item?.boxed
                    ? "border border-gold/16 border-t-2 border-t-gold bg-white/[0.02] p-8 md:p-10"
                    : "",
                  normalizedColumns.length === 1 && "text-center",
                ]}
              >
                {item?.heading && (
                  <h3 class="font-serif text-2xl font-medium text-ivory-200 md:text-3xl">
                    {item.heading}
                  </h3>
                )}
                {item?.copySegments?.map((paragraph) => (
                  <p class="text-base font-light leading-relaxed md:text-lg">
                    {paragraph}
                  </p>
                ))}
                {item?.meta && <p class="text-sm text-gold">{item.meta}</p>}
              </article>
            )
          )}
        </div>
      ))
    }
  </div>
</section>
