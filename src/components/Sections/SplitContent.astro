---
import ResponsivePicture from "../UI/ResponsivePicture.astro";

const { header, copy, columns = [], background_color = "" } = Astro.props;

const normalizedColumns = columns.slice(0, 2).map((column) => ({
  ...column,
  items:
    column?.items?.map((item) => ({
      ...item,
      copySegments: Array.isArray(item?.copy)
        ? item.copy
        : item?.copy
          ? [item.copy]
          : [],
    })) ?? [],
}));
---

<section
  class="px-6 py-12 md:py-20 lg:py-24"
  style={{ backgroundColor: background_color ?? "" }}
>
  <div class="container">
    {
      (header || copy) && (
        <div class="text-center mb-14">
          {header && <h2 class="text-3xl md:text-5xl font-bold text-primary-900">{header}</h2>}
          {copy && (
            <p class="mt-3 text-base sm:text-lg md:text-xl text-ink-muted max-w-2xl mx-auto leading-relaxed">{copy}</p>
          )}
        </div>
      )
    }
  </div>
  <div
    class:list={[
      "grid w-full max-w-5xl mx-auto gap-10 md:gap-14",
      normalizedColumns.length > 1
        ? "grid-cols-1 md:grid-cols-2"
        : "grid-cols-1 max-w-3xl",
    ]}
  >
    {
      normalizedColumns.map((column) => (
        <div class="flex flex-col gap-10 md:gap-14">
          {column.items?.map((item) =>
            item?.image ? (
              <figure class="flex flex-col gap-4">
                <ResponsivePicture
                  src={item.image}
                  alt={item.image_alt ?? ""}
                  class="overflow-hidden rounded-3xl border border-border-subtle shadow-md"
                  imageClass="h-full w-full object-cover"
                />
                {item?.legend && (
                  <figcaption class="text-sm leading-relaxed text-ink-muted md:text-base">
                    {item.legend}
                  </figcaption>
                )}
              </figure>
            ) : (
              <article
                class:list={[
                  "flex flex-col gap-3 text-ink-muted",
                  item?.boxed
                    ? "rounded-3xl bg-surface border border-border-subtle p-8 shadow-sm md:p-10"
                    : "",
                  normalizedColumns.length === 1 && "text-center",
                ]}
              >
                {item?.heading && (
                  <h3 class="text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">
                    {item.heading}
                  </h3>
                )}
                {item?.copySegments?.map((paragraph) => (
                  <p class="text-base leading-relaxed md:text-lg">{paragraph}</p>
                ))}
                {item?.meta && (
                  <p class="text-sm font-semibold uppercase tracking-widest text-accent-600">
                    {item.meta}
                  </p>
                )}
              </article>
            )
          )}
        </div>
      ))
    }
  </div>
</section>
