---
const {
  headline,
  subheadline,
  body_copy = [],
} = Astro.props;

const bodySegments = Array.isArray(body_copy)
  ? body_copy
  : body_copy
    ? [body_copy]
    : [];

// Gold italic accent on the final word of the headline.
const words = (headline ?? "").trim().split(/\s+/).filter(Boolean);
const lastWord = words.length ? words[words.length - 1] : "";
const leadWords = words.slice(0, -1).join(" ");
---

<section
  data-reveal
  class="relative overflow-hidden px-6 py-28 text-center md:py-32"
>
  <!-- Concentric star-map rings -->
  <div
    class="animate-pulsering pointer-events-none absolute left-1/2 top-1/2 -ml-[380px] -mt-[380px] h-[760px] w-[760px] rounded-full border border-gold/10"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 -ml-[260px] -mt-[260px] h-[520px] w-[520px] rounded-full border border-gold/[0.14]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 -ml-[150px] -mt-[150px] h-[300px] w-[300px] rounded-full border border-gold/[0.18]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl">
    {
      subheadline && (
        <div class="mb-7 text-[11px] uppercase tracking-[0.3em] text-gold">
          {subheadline}
        </div>
      )
    }
    {
      headline && (
        <h2 class="m-0 font-serif text-[clamp(30px,4.2vw,56px)] font-medium leading-[1.12] text-ivory-200">
          {leadWords && <>{leadWords}{" "}</>}
          <span class="italic text-gold-light">{lastWord}</span>
        </h2>
      )
    }
    {
      bodySegments.length > 0 && (
        <div class="mx-auto mt-8 max-w-2xl space-y-5 text-base font-light leading-[1.85] text-body md:text-[17px]">
          {bodySegments.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      )
    }
  </div>
</section>
