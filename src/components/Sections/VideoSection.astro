---
import { marked } from "marked";
import DOMPurify from "isomorphic-dompurify";

interface Video {
  video_id: string;
  title?: string;
  copy?: string;
}

interface Props {
  header?: string;
  copy?: string;
  videos?: Video[];
}

const { header, copy, videos } = Astro.props;
---

<section data-reveal class="py-24 md:py-28 bg-gradient-to-b from-bg-panel to-bg-950 border-t border-gold/10">
  <div class="container">
    {(header || copy) && (
      <div class="text-center mb-16">
        {header && <h2 class="font-serif text-[clamp(32px,4.2vw,56px)] font-medium mb-4 text-ivory-200">{header}</h2>}
        {copy && <p class="text-base md:text-lg font-light text-muted max-w-2xl mx-auto leading-relaxed">{copy}</p>}
      </div>
    )}

    <div class="flex flex-col gap-16">
      {videos && videos.map(async (video, index: number) => {
        const rawCopyHtml = await marked.parse(video.copy ?? "");
        const cleanCopyHtml = DOMPurify.sanitize(rawCopyHtml);
        const flexDir = index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse";

        return (
          <div class={`flex flex-col ${flexDir} gap-8 items-center`}>
            <div class="w-full md:w-1/2 overflow-hidden shadow-[0_30px_60px_rgba(0,0,0,0.4)] aspect-video border border-gold/16">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${video.video_id}`}
                title={video.title || "YouTube video player"}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>

            <div class="w-full md:w-1/2">
              <div class="bg-white/[0.02] border border-gold/16 border-t-2 border-t-gold p-8 h-full flex flex-col justify-center">
                {video.title && <h3 class="font-serif text-2xl font-medium mb-4 text-ivory-200">{video.title}</h3>}
                <div class="text-body text-[15px] font-light leading-[1.8] space-y-4" set:html={cleanCopyHtml}></div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>