---
import Button from "../UI/Button.astro";

interface Card {
  icon?: string;
  heading?: string;
  copy?: string;
  button?: {
    url: string;
    text: string;
    style?: "primary" | "secondary" | "accent" | "outline";
  };
}

interface Props {
  header?: string;
  copy?: string;
  eyebrow?: string;
  cards?: Card[];
}

const { header, copy, eyebrow, cards } = Astro.props;
---

<section data-reveal class="px-6 py-24 md:py-28">
  <div class="container mx-auto">
    <div class="mb-14 text-center">
      {
        eyebrow && (
          <div class="mb-4 text-[11px] uppercase tracking-[0.3em] text-gold">
            {eyebrow}
          </div>
        )
      }
      {
        header && (
          <h2 class="m-0 font-serif text-[clamp(32px,4.2vw,56px)] font-medium text-ivory-200">
            {header}
          </h2>
        )
      }
      {
        copy && (
          <p class="mx-auto mt-5 max-w-2xl text-base font-light leading-relaxed text-muted md:text-lg">
            {copy}
          </p>
        )
      }
    </div>

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-3">
      {
        cards &&
          cards.map((card, index: number) => (
            <div class="group border border-gold/16 border-t-2 border-t-gold bg-white/[0.02] p-9 transition-all duration-[400ms] hover:-translate-y-2 hover:bg-gold/5 hover:shadow-[0_30px_60px_rgba(0,0,0,0.4)]">
              {card.icon ? (
                <div
                  class="mb-6 text-5xl"
                  set:html={card.icon}
                />
              ) : (
                <div class="mb-6 font-serif text-3xl italic text-gold">
                  {String(index + 1).padStart(2, "0")}
                </div>
              )}
              {card.heading && (
                <h3 class="mb-4 font-serif text-[27px] font-medium leading-tight text-ivory-200">
                  {card.heading}
                </h3>
              )}
              {card.copy && (
                <p class="text-[15px] font-light leading-[1.8] text-muted">
                  {card.copy}
                </p>
              )}
              {card.button && (
                <div class="mt-7">
                  <Button
                    href={card.button.url}
                    variant={card.button.style || "outline"}
                    size="sm"
                  >
                    {card.button.text}
                  </Button>
                </div>
              )}
            </div>
          ))
      }
    </div>
  </div>
</section>
