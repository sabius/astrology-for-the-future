---
import Button from "../UI/Button.astro";

interface Card {
  icon?: string;
  icon_image?: string;
  heading?: string;
  copy?: string;
  button?: {
    url: string;
    text: string;
    style?: string;
    copy_text?: string;
  };
}

interface Props {
  header?: string;
  copy?: string;
  cards?: Card[];
}

const { header, copy, cards } = Astro.props;

const allowedVariants = new Set(["primary", "secondary", "accent", "outline"]);
---

<section class="section-feature-grid py-16">
  <div class="container mx-auto px-6">
    {header && (
      <h2 class="text-3xl md:text-5xl font-bold text-center mb-16 text-primary-900">
        {header}
      </h2>
    )}
    {copy && (
      <p class="text-lg md:text-xl text-center text-primary-800 mb-12 max-w-3xl mx-auto leading-relaxed">
        {copy}
      </p>
    )}

    <div
      class:list={[
        "grid grid-cols-1 gap-8 md:gap-10 mx-auto",
        cards?.length === 2
          ? "md:grid-cols-2 max-w-4xl"
          : "md:grid-cols-2 lg:grid-cols-3 max-w-7xl",
      ]}
    >
      {
        cards &&
          cards.map((card, index: number) => (
            <div
              class={`bg-white rounded-[32px] shadow-lg p-8 md:p-10 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between ${cards.length === 3 && index === 2 ? "md:col-span-2 md:max-w-md md:mx-auto lg:col-span-1 lg:max-w-none" : ""}`}
            >
              <div>
                {card.icon_image ? (
                  <div class="flex justify-center mb-6">
                    <img
                      src={card.icon_image}
                      alt={card.heading || "Icon"}
                      class="w-16 h-16 md:w-20 md:h-20 object-contain transition-transform duration-300 hover:scale-110 drop-shadow-md"
                      loading="lazy"
                    />
                  </div>
                ) : card.icon ? (
                  <div class="flex justify-center mb-6">
                    <div class="text-7xl md:text-8xl" set:html={card.icon} />
                  </div>
                ) : null}
                {card.heading && (
                  <h3 class="text-2xl md:text-[2rem] font-medium text-center mb-4 text-[#2e2133] tracking-[0.01em]">
                    {card.heading}
                  </h3>
                )}
                {card.copy && (
                  <p class="text-xl text-center mb-8 leading-relaxed">
                    {card.copy}
                  </p>
                )}
              </div>
              {card.button && (
                <div class="flex justify-center mt-auto">
                  <copy-button>
                    <Button
                      href={card.button.url}
                      target={card.button.url.startsWith("http") || card.button.url.includes("wa.me") ? "_blank" : undefined}
                      variant={allowedVariants.has(card.button.style ?? "") ? card.button.style as "primary" | "secondary" | "accent" | "outline" : "secondary"}
                      data-copy-text={card.button.copy_text}
                    >
                      {card.button.text}
                    </Button>
                  </copy-button>
                </div>
              )}
            </div>
          ))
      }
    </div>
  </div>
</section>

<script src="../Lit/CopyButton.ts"></script>
