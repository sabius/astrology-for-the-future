---
import Button from "../UI/Button.astro";

type ButtonVariant = "primary" | "secondary" | "accent" | "outline" | "ghost";

export interface Props {
  eyebrow?: string;
  header: string;
  copy?: string;
  video_id: string;
  source_label?: string;
  language_note?: string;
  play_label?: string;
  youtube_label?: string;
  button?: {
    text: string;
    url: string;
    style?: ButtonVariant;
  };
}

const {
  eyebrow,
  header,
  copy,
  video_id,
  source_label,
  language_note,
  play_label = "Play video",
  youtube_label = "Watch on YouTube",
  button,
} = Astro.props as Props;

const cleanVideoId = video_id.split("?")[0];
const thumbnailUrl = `https://i.ytimg.com/vi/${cleanVideoId}/hqdefault.jpg`;
const youtubeUrl = `https://www.youtube.com/watch?v=${cleanVideoId}`;
---

<section class="featured-video-section pt-16 md:pt-24 pb-4 px-4 sm:px-6 bg-canvas">
  <div class="container max-w-6xl">
    <div
      class="bg-surface border border-border-subtle rounded-3xl p-6 sm:p-10 md:p-12 shadow-lg"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Click-to-Play Framed Video Stage -->
        <div class="lg:col-span-7">
          <div class="relative">
            <!-- Soft ambient halo -->
            <div
              class="pointer-events-none absolute -inset-2 rounded-3xl bg-gradient-to-br from-primary-800/12 via-transparent to-accent-500/15 blur-xl"
              aria-hidden="true"
            >
            </div>

            <div
              data-video-facade
              data-video-id={cleanVideoId}
              data-video-title={header}
              class="relative aspect-video w-full rounded-2xl overflow-hidden bg-midnight border border-accent-300/30 shadow-2xl"
            >
              <button
                type="button"
                data-video-trigger
                aria-label={`${play_label}: ${header}`}
                class="group relative block h-full w-full cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400"
              >
                <img
                  src={thumbnailUrl}
                  alt={header}
                  class="h-full w-full object-cover opacity-90 transition-transform duration-500 ease-out group-hover:scale-105 group-hover:opacity-100"
                  loading="lazy"
                />

                <!-- Nocturnal gradient scrim -->
                <div
                  class="absolute inset-0 bg-gradient-to-t from-midnight/75 via-midnight/15 to-transparent transition-opacity duration-300 group-hover:opacity-80"
                  aria-hidden="true"
                >
                </div>

                <!-- Center Celestial Play Button -->
                <div
                  class="absolute inset-0 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <div
                    class="flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-full border border-accent-300/60 bg-midnight/85 text-white shadow-2xl backdrop-blur-sm transition-all duration-300 group-hover:scale-110 group-hover:bg-accent-500 group-hover:border-accent-300"
                  >
                    <svg
                      class="h-7 w-7 sm:h-8 sm:w-8 fill-current ml-1"
                      viewBox="0 0 24 24"
                    >
                      <path d="M8 5v14l11-7z"></path>
                    </svg>
                  </div>
                </div>

                <!-- Bottom Play Hint -->
                <div
                  class="absolute bottom-3.5 left-4 right-4 flex items-center justify-between text-xs font-medium text-primary-100"
                >
                  <span class="inline-flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-accent-400"></span>
                    <span>{play_label}</span>
                  </span>
                  {
                    language_note && (
                      <span class="rounded-full bg-midnight/75 border border-accent-300/30 px-2.5 py-0.5 text-primary-100 backdrop-blur-xs">
                        {language_note}
                      </span>
                    )
                  }
                </div>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Editorial Context -->
        <div class="lg:col-span-5 text-left">
          {
            eyebrow && (
              <p class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold uppercase tracking-widest text-accent-700 mb-3">
                <svg
                  class="h-3.5 w-3.5 text-accent-500 flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z" />
                </svg>
                <span>{eyebrow}</span>
              </p>
            )
          }

          <h2
            class="font-serif text-3xl sm:text-4xl font-bold text-primary-900 leading-tight"
          >
            {header}
          </h2>

          {
            source_label && (
              <p class="mt-2 text-xs sm:text-sm font-medium text-accent-700">
                {source_label}
              </p>
            )
          }

          {
            copy && (
              <p class="mt-4 text-base md:text-lg text-ink-muted leading-relaxed">
                {copy}
              </p>
            )
          }

          <div class="mt-7 flex flex-wrap items-center gap-4">
            {
              button && (
                <Button
                  href={button.url}
                  variant={button.style ?? "primary"}
                  size="md"
                >
                  {button.text}
                </Button>
              )
            }

            <a
              href={youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 hover:text-accent-600 transition-colors"
            >
              <span>{youtube_label}</span>
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 17L17 7m0 0H9m8 0v8"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const facades = document.querySelectorAll<HTMLElement>("[data-video-facade]");
  facades.forEach((facade) => {
    const trigger = facade.querySelector<HTMLButtonElement>(
      "[data-video-trigger]"
    );
    if (!trigger) return;

    trigger.addEventListener("click", () => {
      const videoId = facade.dataset.videoId;
      const title = facade.dataset.videoTitle || "YouTube video player";
      if (!videoId) return;

      const iframe = document.createElement("iframe");
      iframe.className = "h-full w-full";
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.allowFullscreen = true;

      facade.replaceChildren(iframe);
    });
  });
</script>
