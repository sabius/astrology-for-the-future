---
import { marked } from "marked";
import DOMPurify from "isomorphic-dompurify";
import Button from "../UI/Button.astro";
import { getCurrentLocaleFromAstro } from "../../i18n";

interface NavVideo {
  text?: string;
  title?: string;
  url: string;
}

interface Props {
  video_id: string;
  header?: string;
  copy?: string;
  upload_date?: string;
  button?: {
    text: string;
    url: string;
    style?: "primary" | "secondary" | "accent" | "outline";
  };
  prev_video?: NavVideo;
  next_video?: NavVideo;
}

const { video_id, header, copy, button, prev_video, next_video } = Astro.props as Props;
const currentLocale = getCurrentLocaleFromAstro(Astro);

const prevLabel = prev_video?.text ?? (currentLocale === "es" ? "Video anterior" : "Previous Video");
const nextLabel = next_video?.text ?? (currentLocale === "es" ? "Siguiente video" : "Next Video");

const rawCopyHtml = await marked.parse(copy ?? "");
const cleanCopyHtml = DOMPurify.sanitize(rawCopyHtml);
---

<section class="py-12 md:py-16 bg-gray-50">
  <div class="container mx-auto px-4 max-w-4xl">
    {header && (
      <div class="mb-8">
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
          {header}
        </h1>
      </div>
    )}

    <!-- Prominent Video Player (Primary Main Content) -->
    <div class="w-full rounded-2xl overflow-hidden shadow-2xl bg-black aspect-video mb-12">
      <iframe
        class="w-full h-full"
        src={`https://www.youtube.com/embed/${video_id}`}
        title={header || "YouTube video player"}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

    <!-- Detailed Notes & Copy -->
    {copy && (
      <div class="bg-white p-8 md:p-10 rounded-2xl shadow-md border border-gray-100 mb-12">
        <div class="prose max-w-none text-gray-800 text-lg leading-relaxed space-y-4" set:html={cleanCopyHtml}></div>
      </div>
    )}

    <!-- Previous / Next Video Navigation -->
    {(prev_video || next_video) && (
      <div class="border-t border-b border-gray-200 py-8 my-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        {prev_video ? (
          <a
            href={prev_video.url}
            class="group flex items-center gap-3 p-4 rounded-xl bg-white border border-gray-200 hover:border-primary-500 hover:shadow-md transition-all duration-300 w-full sm:w-1/2 text-left"
          >
            <div class="w-10 h-10 rounded-full bg-primary-50 text-primary-600 group-hover:bg-primary-600 group-hover:text-white flex items-center justify-center transition-colors flex-shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-xs font-semibold uppercase tracking-wider text-primary-600 group-hover:text-primary-700 block mb-0.5">
                {prevLabel}
              </span>
              {prev_video.title && (
                <span class="text-sm font-medium text-gray-900 line-clamp-1 group-hover:text-primary-800 transition-colors">
                  {prev_video.title}
                </span>
              )}
            </div>
          </a>
        ) : (
          <div class="hidden sm:block sm:w-1/2"></div>
        )}

        {next_video && (
          <a
            href={next_video.url}
            class="group flex items-center justify-end text-right gap-3 p-4 rounded-xl bg-white border border-gray-200 hover:border-primary-500 hover:shadow-md transition-all duration-300 w-full sm:w-1/2 ml-auto"
          >
            <div class="min-w-0">
              <span class="text-xs font-semibold uppercase tracking-wider text-primary-600 group-hover:text-primary-700 block mb-0.5">
                {nextLabel}
              </span>
              {next_video.title && (
                <span class="text-sm font-medium text-gray-900 line-clamp-1 group-hover:text-primary-800 transition-colors">
                  {next_video.title}
                </span>
              )}
            </div>
            <div class="w-10 h-10 rounded-full bg-primary-50 text-primary-600 group-hover:bg-primary-600 group-hover:text-white flex items-center justify-center transition-colors flex-shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
              </svg>
            </div>
          </a>
        )}
      </div>
    )}

    {button && (
      <div class="text-center mt-8">
        <Button href={button.url} variant={button.style ?? "primary"}>
          {button.text}
        </Button>
      </div>
    )}
  </div>
</section>
