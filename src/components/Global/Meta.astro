---
import { getCurrentLocaleFromAstro } from "../../i18n/index";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  videoId?: string;
  uploadDate?: string;
  enUrl?: string;
  esUrl?: string;
}

const { title, description, image, canonicalUrl, videoId, uploadDate, enUrl, esUrl } = Astro.props as Props;

const site = Astro.site?.toString() || "https://glendaferreira.com";
const origin = site.endsWith("/") ? site.slice(0, -1) : site;
const rawPathname = Astro.url?.pathname ?? "/";

function getSeoUrls(pathname: string, originUrl: string) {
  let clean = pathname;
  if (!clean.startsWith("/")) clean = "/" + clean;
  
  let defaultEnPath = "/";
  let defaultEsPath = "/es/";
  let currentCanonicalPath = "/";

  if (clean === "/" || clean === "/en" || clean === "/en/") {
    defaultEnPath = "/";
    defaultEsPath = "/es/";
    currentCanonicalPath = clean.startsWith("/es") ? "/es/" : "/";
  } else if (clean === "/es" || clean === "/es/") {
    defaultEnPath = "/";
    defaultEsPath = "/es/";
    currentCanonicalPath = "/es/";
  } else if (clean.startsWith("/es/")) {
    const sub = clean.slice(3);
    const formattedSub = sub.endsWith("/") ? sub : sub + "/";
    defaultEnPath = formattedSub;
    defaultEsPath = "/es" + formattedSub;
    currentCanonicalPath = defaultEsPath;
  } else if (clean.startsWith("/en/")) {
    const sub = clean.slice(3);
    const formattedSub = sub.endsWith("/") ? sub : sub + "/";
    defaultEnPath = formattedSub;
    defaultEsPath = "/es" + formattedSub;
    currentCanonicalPath = defaultEnPath;
  } else {
    const formattedSub = clean.endsWith("/") ? clean : clean + "/";
    defaultEnPath = formattedSub;
    defaultEsPath = "/es" + formattedSub;
    currentCanonicalPath = defaultEnPath;
  }

  const finalEnHref = enUrl
    ? enUrl.startsWith("http")
      ? enUrl
      : `${originUrl}${enUrl.startsWith("/") ? enUrl : "/" + enUrl}`
    : `${originUrl}${defaultEnPath}`;

  const finalEsHref = esUrl
    ? esUrl.startsWith("http")
      ? esUrl
      : `${originUrl}${esUrl.startsWith("/") ? esUrl : "/" + esUrl}`
    : `${originUrl}${defaultEsPath}`;

  return {
    canonical: canonicalUrl || `${originUrl}${currentCanonicalPath}`,
    hreflangEn: finalEnHref,
    hreflangEs: finalEsHref,
    hreflangDefault: finalEnHref,
  };
}

const { canonical, hreflangEn, hreflangEs, hreflangDefault } = getSeoUrls(rawPathname, origin);
const locale = getCurrentLocaleFromAstro(Astro);
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const siteName = "Glenda Ferreira";
const twitterCard = image ? "summary_large_image" : "summary";

const cleanVideoId = videoId ? videoId.split("?")[0] : undefined;
const videoThumbnail = image || (cleanVideoId ? `https://img.youtube.com/vi/${cleanVideoId}/hqdefault.jpg` : undefined);

const videoSchemaJson = videoId ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": description || title,
  "thumbnailUrl": videoThumbnail ? [videoThumbnail] : [],
  "uploadDate": uploadDate || "2025-01-01T00:00:00Z",
  "embedUrl": `https://www.youtube.com/embed/${videoId}`
}) : undefined;
---

{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />

<!-- Multilingual hreflang annotations -->
<link rel="alternate" hreflang="en" href={hreflangEn} />
<link rel="alternate" hreflang="es" href={hreflangEs} />
<link rel="alternate" hreflang="x-default" href={hreflangDefault} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
{image && <meta property="og:image" content={image} />}

<!-- Twitter -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image} />}

<!-- Structured Data VideoObject -->
{videoSchemaJson && <script type="application/ld+json" set:html={videoSchemaJson}></script>}
