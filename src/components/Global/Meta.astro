---
import { getCurrentLocaleFromAstro } from "../../i18n/index";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  videoId?: string;
  uploadDate?: string;
  enUrl?: string;
  esUrl?: string;
}

const { title, description, image, canonicalUrl, videoId, uploadDate, enUrl, esUrl } = Astro.props as Props;

const site = Astro.site?.toString() || "https://glendaferreira.com";
const origin = site.endsWith("/") ? site.slice(0, -1) : site;
const rawPathname = Astro.url?.pathname ?? "/";

function getSeoUrls(pathname: string, originUrl: string) {
  let clean = pathname;
  if (!clean.startsWith("/")) clean = "/" + clean;
  
  let defaultEnPath = "/";
  let defaultEsPath = "/es/";
  let currentCanonicalPath = "/";

  if (clean === "/" || clean === "/en" || clean === "/en/") {
    defaultEnPath = "/";
    defaultEsPath = "/es/";
    currentCanonicalPath = clean.startsWith("/es") ? "/es/" : "/";
  } else if (clean === "/es" || clean === "/es/") {
    defaultEnPath = "/";
    defaultEsPath = "/es/";
    currentCanonicalPath = "/es/";
  } else if (clean.startsWith("/es/")) {
    const sub = clean.slice(3);
    const formattedSub = sub.endsWith("/") ? sub : sub + "/";
    defaultEnPath = formattedSub;
    defaultEsPath = "/es" + formattedSub;
    currentCanonicalPath = defaultEsPath;
  } else if (clean.startsWith("/en/")) {
    const sub = clean.slice(3);
    const formattedSub = sub.endsWith("/") ? sub : sub + "/";
    defaultEnPath = formattedSub;
    defaultEsPath = "/es" + formattedSub;
    currentCanonicalPath = defaultEnPath;
  } else {
    const formattedSub = clean.endsWith("/") ? clean : clean + "/";
    defaultEnPath = formattedSub;
    defaultEsPath = "/es" + formattedSub;
    currentCanonicalPath = defaultEnPath;
  }

  const finalEnHref = enUrl
    ? enUrl.startsWith("http")
      ? enUrl
      : `${originUrl}${enUrl.startsWith("/") ? enUrl : "/" + enUrl}`
    : `${originUrl}${defaultEnPath}`;

  const finalEsHref = esUrl
    ? esUrl.startsWith("http")
      ? esUrl
      : `${originUrl}${esUrl.startsWith("/") ? esUrl : "/" + esUrl}`
    : `${originUrl}${defaultEsPath}`;

  return {
    canonical: canonicalUrl || `${originUrl}${currentCanonicalPath}`,
    hreflangEn: finalEnHref,
    hreflangEs: finalEsHref,
    hreflangDefault: finalEnHref,
  };
}

const { canonical, hreflangEn, hreflangEs, hreflangDefault } = getSeoUrls(rawPathname, origin);
const locale = getCurrentLocaleFromAstro(Astro);
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const siteName = "Glenda Ferreira";

const DEFAULT_OG_IMAGES = {
  en: {
    url: "https://res.cloudinary.com/dvhwjf1zd/image/upload/v1768881851/Glenda%20Ferreira/meta-img-en.jpg",
    width: 982,
    height: 647,
    type: "image/jpeg",
  },
  es: {
    url: "https://res.cloudinary.com/dvhwjf1zd/image/upload/v1768882107/Glenda%20Ferreira/meta-img-es.jpg",
    width: 975,
    height: 687,
    type: "image/jpeg",
  },
} as const;

const cleanVideoId = videoId ? videoId.split("?")[0] : undefined;
const defaultOg = locale === "es" ? DEFAULT_OG_IMAGES.es : DEFAULT_OG_IMAGES.en;
const ogImage =
  image ||
  (cleanVideoId
    ? `https://img.youtube.com/vi/${cleanVideoId}/hqdefault.jpg`
    : defaultOg.url);

const getImageMetadata = (imgUrl: string) => {
  if (imgUrl === DEFAULT_OG_IMAGES.en.url) {
    return {
      width: DEFAULT_OG_IMAGES.en.width,
      height: DEFAULT_OG_IMAGES.en.height,
      type: DEFAULT_OG_IMAGES.en.type,
    };
  }
  if (imgUrl === DEFAULT_OG_IMAGES.es.url) {
    return {
      width: DEFAULT_OG_IMAGES.es.width,
      height: DEFAULT_OG_IMAGES.es.height,
      type: DEFAULT_OG_IMAGES.es.type,
    };
  }
  if (imgUrl.includes("img.youtube.com/vi/") && imgUrl.endsWith("/hqdefault.jpg")) {
    return { width: 480, height: 360, type: "image/jpeg" };
  }
  const lower = imgUrl.toLowerCase();
  const type = lower.endsWith(".png")
    ? "image/png"
    : lower.endsWith(".webp")
      ? "image/webp"
      : "image/jpeg";
  return { width: undefined, height: undefined, type };
};

const ogImageMeta = getImageMetadata(ogImage);
const twitterCard = ogImage ? "summary_large_image" : "summary";
const videoThumbnail = ogImage;

const videoSchemaJson = videoId ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": description || title,
  "thumbnailUrl": videoThumbnail ? [videoThumbnail] : [],
  "uploadDate": uploadDate || "2025-01-01T00:00:00Z",
  "embedUrl": `https://www.youtube.com/embed/${videoId}`
}) : undefined;
---

{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />

<!-- Multilingual hreflang annotations -->
<link rel="alternate" hreflang="en" href={hreflangEn} />
<link rel="alternate" hreflang="es" href={hreflangEs} />
<link rel="alternate" hreflang="x-default" href={hreflangDefault} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      {ogImage.startsWith("https://") && (
        <meta property="og:image:secure_url" content={ogImage} />
      )}
      <meta property="og:image:type" content={ogImageMeta.type} />
      {ogImageMeta.width && (
        <meta property="og:image:width" content={String(ogImageMeta.width)} />
      )}
      {ogImageMeta.height && (
        <meta property="og:image:height" content={String(ogImageMeta.height)} />
      )}
      <meta property="og:image:alt" content={title} />
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- Structured Data VideoObject -->
{videoSchemaJson && <script type="application/ld+json" set:html={videoSchemaJson}></script>}
