---
import {
  t,
  getCurrentLocaleFromAstro,
  getLocaleSwitchHref,
} from "../../i18n/index";

interface Props {
  enUrl?: string;
  esUrl?: string;
}

const { enUrl, esUrl } = Astro.props as Props;
const locale = getCurrentLocaleFromAstro(Astro);
const currentPath = Astro.url.pathname;
const isRoot = currentPath === "/";

const enSwitchHref = getLocaleSwitchHref(currentPath, "en", { enUrl, esUrl });
const esSwitchHref = getLocaleSwitchHref(currentPath, "es", { enUrl, esUrl });

const getPath = (path: string, loc: string) => {
  if (path === "/") {
    return isRoot ? "/" : `/${loc}`;
  }
  return `/${loc}${path}`;
};

const enNavItems = [
  { text: await t("nav.home", "en"), href: getPath("/", "en") },
  { text: await t("nav.videos", "en"), href: getPath("/videos", "en") },
  { text: await t("nav.contact", "en"), href: getPath("/contact", "en") },
];

const esNavItems = [
  { text: await t("nav.home", "es"), href: getPath("/", "es") },
  { text: await t("nav.videos", "es"), href: getPath("/videos", "es") },
  { text: await t("nav.contact", "es"), href: getPath("/contact", "es") },
];

const normalizePath = (p: string) =>
  p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;

const normalizedCurrentPath = normalizePath(currentPath);

const isHomeHref = (href: string) =>
  href === "/" || href === "/en" || href === "/es";

const enNavLinks = enNavItems.map((item) => ({
  ...item,
  isActive: isHomeHref(item.href)
    ? normalizedCurrentPath === normalizePath(item.href)
    : normalizedCurrentPath.startsWith(normalizePath(item.href)),
}));

const esNavLinks = esNavItems.map((item) => ({
  ...item,
  isActive: isHomeHref(item.href)
    ? normalizedCurrentPath === normalizePath(item.href)
    : normalizedCurrentPath.startsWith(normalizePath(item.href)),
}));
---

<!-- Desktop Navigation -->
<nav class="hidden lg:flex items-center space-x-8">
  {
    isRoot ? (
      <>
        <ul class="lang-en flex items-center space-x-8">
          {enNavLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class={`nav-link text-base font-medium transition-colors pb-1 ${
                  item.isActive
                    ? "text-primary-900 font-semibold border-b-2 border-accent-500"
                    : "text-ink-muted hover:text-primary-900"
                }`}
                aria-current={item.isActive ? "page" : undefined}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>

        <ul class="lang-es flex items-center space-x-8">
          {esNavLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class={`nav-link text-base font-medium transition-colors pb-1 ${
                  item.isActive
                    ? "text-primary-900 font-semibold border-b-2 border-accent-500"
                    : "text-ink-muted hover:text-primary-900"
                }`}
                aria-current={item.isActive ? "page" : undefined}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <ul class="flex items-center space-x-8">
        {(locale === "es" ? esNavLinks : enNavLinks).map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav-link text-base font-medium transition-colors pb-1 ${
                item.isActive
                  ? "text-primary-900 font-semibold border-b-2 border-accent-500"
                  : "text-ink-muted hover:text-primary-900"
              }`}
              aria-current={item.isActive ? "page" : undefined}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <!-- Desktop Language Switcher -->
  <span class="h-5 w-px bg-border-subtle" aria-hidden="true"></span>
  <language-switcher
    currentPath={currentPath}
    isRoot={isRoot}
    class="nav-lang-switcher inline-flex items-center rounded-full border border-border-subtle bg-canvas p-0.5 text-xs font-semibold tracking-wider"
    aria-label="Language switcher"
  >
    <a
      href={enSwitchHref}
      data-lang-btn="en"
      aria-label="English"
      class="rounded-full px-3 py-1.5 transition-colors cursor-pointer"
    >
      EN
    </a>
    <a
      href={esSwitchHref}
      data-lang-btn="es"
      aria-label="Español"
      class="rounded-full px-3 py-1.5 transition-colors cursor-pointer"
    >
      ES
    </a>
  </language-switcher>
</nav>

<!-- Mobile Controls: Quick Language Switcher + Menu Button -->
<div class="lg:hidden flex items-center gap-3">
  <language-switcher
    currentPath={currentPath}
    isRoot={isRoot}
    class="nav-lang-switcher inline-flex items-center rounded-full border border-border-subtle bg-canvas p-0.5 text-xs font-semibold tracking-wider"
    aria-label="Language switcher"
  >
    <a
      href={enSwitchHref}
      data-lang-btn="en"
      aria-label="English"
      class="rounded-full px-2.5 py-1 transition-colors cursor-pointer"
    >
      EN
    </a>
    <a
      href={esSwitchHref}
      data-lang-btn="es"
      aria-label="Español"
      class="rounded-full px-2.5 py-1 transition-colors cursor-pointer"
    >
      ES
    </a>
  </language-switcher>

  <button
    id="mobile-menu-button"
    class="p-2 text-primary-900 hover:text-accent-600 focus:outline-none transition-colors relative"
    aria-label="Toggle Menu"
    aria-expanded="false"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
</div>

<!-- Mobile Menu Dropdown - Compact & Clean -->
<div
  id="mobile-menu"
  class="nav-mobile bg-surface absolute top-full left-0 right-0 shadow-lg border-t border-border-subtle transform opacity-0 origin-top transition-opacity duration-300 ease-out invisible z-50"
  role="menu"
  aria-labelledby="mobile-menu-button"
>
  <!-- Navigation Links in Grid -->
  <div class="px-4 py-6">
    {
      isRoot ? (
        <>
          <div class="lang-en grid grid-cols-1 gap-3">
            {enNavLinks.map((item) => (
              <a
                href={item.href}
                class={`block px-4 py-3 font-medium rounded-xl transition-colors text-center text-xl ${
                  item.isActive
                    ? "bg-accent-50 text-primary-900 border border-accent-300/60"
                    : "text-primary-900 hover:bg-surface-alt border border-transparent"
                }`}
                role="menuitem"
                aria-current={item.isActive ? "page" : undefined}
              >
                {item.text}
              </a>
            ))}
          </div>

          <div class="lang-es grid grid-cols-1 gap-3">
            {esNavLinks.map((item) => (
              <a
                href={item.href}
                class={`block px-4 py-3 font-medium rounded-xl transition-colors text-center text-xl ${
                  item.isActive
                    ? "bg-accent-50 text-primary-900 border border-accent-300/60"
                    : "text-primary-900 hover:bg-surface-alt border border-transparent"
                }`}
                role="menuitem"
                aria-current={item.isActive ? "page" : undefined}
              >
                {item.text}
              </a>
            ))}
          </div>
        </>
      ) : (
        <div class="grid grid-cols-1 gap-3">
          {(locale === "es" ? esNavLinks : enNavLinks).map((item) => (
            <a
              href={item.href}
              class={`block px-4 py-3 font-medium rounded-xl transition-colors text-center text-xl ${
                item.isActive
                  ? "bg-accent-50 text-primary-900 border border-accent-300/60"
                  : "text-primary-900 hover:bg-surface-alt border border-transparent"
              }`}
              role="menuitem"
              aria-current={item.isActive ? "page" : undefined}
            >
              {item.text}
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  #mobile-menu-button {
    cursor: pointer;
  }

  #mobile-menu-button:hover svg {
    transform: scale(1.1);
  }

  #mobile-menu-button svg {
    transition: transform 0.2s ease;
  }

  #mobile-menu a {
    transition: all 0.15s ease;
  }

  #mobile-menu a[aria-current="page"] {
    font-weight: 600;
  }
</style>

<script>
  // Mobile menu functionality
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuButton = document.getElementById("mobile-menu-button")!;
    const mobileMenu = document.getElementById("mobile-menu")!;

    // Use global variable for menu state
    window.__NAV_MENU_OPEN__ = false;

    // Function to toggle mobile menu
    const toggleMobileMenu = () => {
      window.__NAV_MENU_OPEN__ = !window.__NAV_MENU_OPEN__;

      if (window.__NAV_MENU_OPEN__) {
        // Show menu
        mobileMenu.classList.remove("opacity-0");
        mobileMenu.classList.remove("invisible");
        mobileMenuButton.setAttribute("aria-expanded", "true");
      } else {
        // Hide menu
        mobileMenu.classList.add("opacity-0");
        mobileMenu.classList.add("invisible");
        mobileMenuButton.setAttribute("aria-expanded", "false");
      }
    };

    // Event listeners
    mobileMenuButton?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMobileMenu();
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      if (
        window.__NAV_MENU_OPEN__ &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenuButton.contains(e.target as Node)
      ) {
        toggleMobileMenu();
      }
    });

    // Close menu when clicking a navigation link
    const navLinks = mobileMenu?.querySelectorAll('a[href^="/"]');
    navLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.__NAV_MENU_OPEN__) {
          setTimeout(() => toggleMobileMenu(), 100);
        }
      });
    });

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && window.__NAV_MENU_OPEN__) {
        toggleMobileMenu();
      }
    });

    // Handle window resize
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && window.__NAV_MENU_OPEN__) {
        toggleMobileMenu();
      }
    });
  });
</script>
