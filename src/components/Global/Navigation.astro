---
import { t, getCurrentLocaleFromAstro } from "../../i18n/index";
const locale = getCurrentLocaleFromAstro(Astro);
const getPath = (path: string, locale: string) => {
  // Always use locale prefix so links stay within the current language
  return `/${locale}${path === "/" ? "" : path}`;
};
const navItems = [
  { text: await t("nav.home", locale), href: getPath("/", locale) },
  { text: await t("nav.videos", locale), href: getPath("/videos", locale) },
  { text: await t("nav.contact", locale), href: getPath("/contact", locale) },
];

const currentPath = Astro.url.pathname;

const navLinks = navItems.map((item) => {
  const isActive =
    item.href === getPath("/", locale)
      ? currentPath === item.href
      : currentPath.startsWith(item.href);
  return { ...item, isActive };
});
---

<!-- Desktop Navigation -->
<nav class="hidden lg:block">
  <ul class="flex items-center gap-2">
    {
      navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            class={`nav-link rounded-full px-4 py-2 text-base font-semibold tracking-wide transition-colors hover:bg-primary-100/70 hover:text-primary-700 ${
              item.isActive ? "bg-white text-primary-700 shadow-sm" : "text-primary-950"
            }`}
            aria-current={item.isActive ? "page" : undefined}
          >
            {item.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<!-- Mobile Menu Button -->
<button
  id="mobile-menu-button"
  class="relative rounded-full border border-primary-900/10 bg-white/70 p-3 text-primary-900 shadow-sm transition-colors hover:text-primary-600 focus:outline-none lg:hidden"
  aria-label="Toggle Menu"
  aria-expanded="false"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-6 w-6"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>

<!-- Mobile Menu Dropdown - Compact & Clean -->
<div
  id="mobile-menu"
  class="nav-mobile invisible absolute left-0 right-0 top-full z-50 origin-top border-t border-primary-900/10 bg-cosmic-cream/95 opacity-0 shadow-2xl backdrop-blur-xl transition-opacity duration-300 ease-out"
  role="menu"
  aria-labelledby="mobile-menu-button"
>
  <!-- Navigation Links in Grid -->
  <div class="px-4 py-6">
    <div class="grid grid-cols-1 gap-3">
      {
        navLinks.map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-3 font-medium rounded-lg transition-colors text-center text-2xl text-primary-950 ${
              item.isActive
                ? "bg-primary-50 text-primary-600 border border-primary-200"
                : "text-gray-900 hover:text-primary-600 border border-transparent"
            }`}
            role="menuitem"
            aria-current={item.isActive ? "page" : undefined}
          >
            {item.text}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  #mobile-menu-button {
    cursor: pointer;
  }

  /* Mobile menu button animation */
  #mobile-menu-button:hover svg {
    transform: scale(1.1);
  }

  #mobile-menu-button svg {
    transition: transform 0.2s ease;
  }

  /* Smooth hover effects */
  #mobile-menu a {
    transition: all 0.15s ease;
  }

  /* Active state styling */
  #mobile-menu a[aria-current="page"] {
    font-weight: 600;
  }
  .nav-link {
    text-decoration: underline 1px rgba(0, 0, 0, 0);
    transition: text-decoration-color 300ms;
  }

  a:hover {
    text-decoration-color: rgba(2.86, 0.46, 0.57, 1);
  }
</style>

<script>
  // Mobile menu functionality
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuButton = document.getElementById("mobile-menu-button")!;
    const mobileMenu = document.getElementById("mobile-menu")!;

    // Use global variable for menu state
    window.__NAV_MENU_OPEN__ = false;

    // Function to toggle mobile menu
    const toggleMobileMenu = () => {
      window.__NAV_MENU_OPEN__ = !window.__NAV_MENU_OPEN__;

      if (window.__NAV_MENU_OPEN__) {
        // Show menu
        mobileMenu.classList.remove("opacity-0");
        mobileMenu.classList.remove("invisible");
        mobileMenuButton.setAttribute("aria-expanded", "true");
      } else {
        // Hide menu
        mobileMenu.classList.add("opacity-0");
        mobileMenu.classList.add("invisible");
        mobileMenuButton.setAttribute("aria-expanded", "false");
      }
    };

    // Event listeners
    mobileMenuButton?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMobileMenu();
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      if (
        window.__NAV_MENU_OPEN__ &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenuButton.contains(e.target as Node)
      ) {
        toggleMobileMenu();
      }
    });

    // Close menu when clicking a navigation link
    const navLinks = mobileMenu?.querySelectorAll('a[href^="/"]');
    navLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.__NAV_MENU_OPEN__) {
          setTimeout(() => toggleMobileMenu(), 100);
        }
      });
    });

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && window.__NAV_MENU_OPEN__) {
        toggleMobileMenu();
      }
    });

    // Handle window resize
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && window.__NAV_MENU_OPEN__) {
        toggleMobileMenu();
      }
    });
  });
</script>
