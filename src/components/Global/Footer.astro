---
import { t, getCurrentLocaleFromAstro } from "../../i18n/index";
const locale = getCurrentLocaleFromAstro(Astro);
// Social media links
const socialLinks = [
  {
    name: "Facebook",
    href: "https://www.facebook.com/prima.vera.71619533",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>`,
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/11qanil/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>`,
  },
  {
    name: "YouTube",
    href: "https://www.youtube.com/@glendaferreira",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>`,
  },
];

// Current year for copyright
const currentYear = new Date().getFullYear();

const followMe = await t("footer.follow", locale);
const copyright = await t("footer.rights", locale);
const privacy = await t("footer.privacy", locale);
const terms = await t("footer.terms", locale);
const tagline = await t("footer.tagline", locale);
const language = await t("footer.language", locale);
---

<footer class="border-t border-gold/16 bg-bg-footer text-faint">
  <div class="container">
    <div
      class="grid grid-cols-1 gap-10 pt-16 pb-10 md:grid-cols-[1.4fr_1fr_1fr]"
    >
      <!-- Wordmark + tagline -->
      <div>
        <div class="mb-4 font-serif text-2xl text-ivory-200">
          {await t("site.title", locale)}
        </div>
        <p class="max-w-xs text-sm font-light leading-relaxed text-faint">
          {tagline}
        </p>
      </div>

      <!-- Follow me -->
      <div>
        <div
          class="mb-5 text-[11px] uppercase tracking-[0.24em] text-gold"
        >
          {followMe}
        </div>
        <ul class="flex flex-col gap-3">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-3 text-sm font-light text-navlink transition-colors hover:text-gold-light"
                  aria-label={link.name}
                >
                  <Fragment set:html={link.icon} />
                  <span>{link.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Language -->
      <div>
        <div
          class="mb-5 text-[11px] uppercase tracking-[0.24em] text-gold"
        >
          {language}
        </div>
        <div class="flex flex-col gap-3">
          <a
            href={Astro.url.pathname.replace(/^\/(en|es)/, "/en")}
            class={`text-sm transition-colors hover:text-gold-light ${locale === "en" ? "font-normal text-gold-light" : "font-light text-navlink"}`}
            >English</a
          >
          <a
            href={Astro.url.pathname.replace(/^\/(en|es)/, "/es")}
            class={`text-sm transition-colors hover:text-gold-light ${locale === "es" ? "font-normal text-gold-light" : "font-light text-navlink"}`}
            >Español</a
          >
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-white/5 py-8"
    >
      <span class="text-[13px] font-light text-faintest"
        >&copy; {currentYear} {await t("site.title", locale)}. {copyright}</span
      >
      <div class="flex gap-7">
        <a
          href="/privacy-policy"
          class="text-[13px] font-light text-faintest transition-colors hover:text-navlink"
          >{privacy}</a
        >
        <a
          href="/terms-of-service"
          class="text-[13px] font-light text-faintest transition-colors hover:text-navlink"
          >{terms}</a
        >
      </div>
    </div>
  </div>
</footer>
